# ============================================================
# Jardín El Encanto — Variables de entorno
# Copiar a .env.local y completar con valores reales.
# NUNCA commitear .env.local
# ============================================================

# Supabase — obtener desde: Settings > API en el dashboard de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Service Role — solo para scripts del servidor / migrations, NUNCA exponer al cliente
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# CallMeBot WhatsApp — notificaciones de nuevos contactos
# Registrar número en https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_PHONE=57XXXXXXXXXX
CALLMEBOT_API_KEY=tu-api-key
# Número central oficial (notificaciones de cada nuevo contacto)
CALLMEBOT_PHONE_CENTRAL=57XXXXXXXXXX
CALLMEBOT_API_KEY_CENTRAL=tu-api-key-central
# Notificaciones por asesor: configurar callmebot_api_key en el perfil del asesor en BD

# Hosting de contenido (contenido.jardindelencanto.com) — ver scripts/hosting/
# Secreto compartido con /home/jardinde/upload-config.php (mismo valor en ambos).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HOSTING_UPLOAD_TOKEN=
# Opcional — por defecto https://contenido.jardindelencanto.com/upload.php
HOSTING_UPLOAD_URL=

# reCAPTCHA v3 — claves de https://www.google.com/recaptcha/admin (dominio jardindelencanto.com)
# Sin RECAPTCHA_SECRET_KEY el formulario de contacto NO verifica bots: obligatoria en producción.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
